# Ethereum artifacts
geth-fork/**/*.zk filter=lfs diff=lfs merge=lfs -text
geth-fork/**/*.statediff filter=lfs diff=lfs merge=lfs -text

# Agent artifacts
.agentic-qe/**/*.embedding filter=lfs diff=lfs merge=lfs -text
