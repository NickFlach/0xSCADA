# Reality Artifacts - Large Binary Objects
*.trace filter=lfs diff=lfs merge=lfs -text
*.proof filter=lfs diff=lfs merge=lfs -text
*.witness filter=lfs diff=lfs merge=lfs -text
*.artifact filter=lfs diff=lfs merge=lfs -text
*.snapshot filter=lfs diff=lfs merge=lfs -text
*.twin filter=lfs diff=lfs merge=lfs -text

# Kernel artifacts
