{
  "dashboard": {
    "id": null,
    "uid": "0xscada-gateway",
    "title": "0xSCADA Gateway Status",
    "tags": ["0xscada", "gateway", "opcua"],
    "timezone": "browser",
    "refresh": "15s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Driver Connection Status",
        "type": "stat",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "scada_gateway_connections",
            "legendFormat": "{{driver}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "DISCONNECTED", "color": "red" }, "1": { "text": "CONNECTED", "color": "green" } } }
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Active Subscriptions",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "scada_gateway_subscriptions",
            "legendFormat": "Subscriptions"
          }
        ]
      },
      {
        "id": 3,
        "title": "Monitored Items",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 4 },
        "targets": [
          {
            "expr": "scada_gateway_monitored_items",
            "legendFormat": "Items"
          }
        ]
      },
      {
        "id": 4,
        "title": "Data Change Rate",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
        "targets": [
          {
            "expr": "sum(rate(scada_gateway_data_changes_total[5m]))",
            "legendFormat": "Changes/s"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "ops" } }
      },
      {
        "id": 5,
        "title": "Data Changes by Driver",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "rate(scada_gateway_data_changes_total[5m])",
            "legendFormat": "{{driver}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "lineWidth": 2, "fillOpacity": 20 }
          }
        }
      },
      {
        "id": 6,
        "title": "Read/Write Latency (P95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(scada_gateway_read_duration_seconds_bucket[5m]))",
            "legendFormat": "Read P95"
          },
          {
            "expr": "histogram_quantile(0.95, rate(scada_gateway_write_duration_seconds_bucket[5m]))",
            "legendFormat": "Write P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "lineWidth": 2, "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 7,
        "title": "Errors by Driver",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "rate(scada_gateway_errors_total[5m])",
            "legendFormat": "{{driver}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "lineWidth": 2, "fillOpacity": 10 }
          }
        }
      },
      {
        "id": 8,
        "title": "Reconnection Attempts",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "rate(scada_gateway_reconnections_total[5m])",
            "legendFormat": "{{driver}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "lineWidth": 2, "fillOpacity": 10 }
          }
        }
      }
    ]
  }
}
