{
  "name": "0xscada",
  "version": "1.0.0",
  "description": "Industrial SCADA system with blockchain-backed audit trails",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "NODE_ENV=development tsx server/index.ts",
    "dev:setup": "npm run dev:db && npm run dev",
    "dev:db": "echo 'Setting up development database...' && node -e \"console.log('Database will be created automatically on first run')\"",
    "start": "node dist/server/index.js",
    "test": "vitest",
    "test:integration": "vitest test/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "azure-iot-device": "^1.17.8",
    "azure-iot-device-mqtt": "^1.15.6",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.29.0",
    "drizzle-zod": "^0.5.1",
    "ethers": "^6.16.0",
    "express": "^4.18.0",
    "hardhat": "^3.1.10",
    "ioredis": "^5.3.0",
    "lucide-react": "^0.344.0",
    "openapi-types": "^12.1.0",
    "pg": "^8.11.0",
    "pino": "^8.17.0",
    "pino-pretty": "^13.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^0.0.55",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "wouter": "^2.12.0",
    "ws": "^8.16.0",
    "zod": "^3.22.0",
    "zod-validation-error": "^3.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.2.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/sqlite3": "^3.1.6",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
