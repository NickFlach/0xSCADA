# 0xSCADA Industrial Reality Capture Configuration
#

menuconfig SCADA_0X
	tristate "0xSCADA Industrial Reality Capture"
	depends on TRACING
	help
	  This option enables the 0xSCADA industrial reality capture
	  subsystem. It provides infrastructure for capturing, verifying,
	  and versioning industrial control system events as cryptographic
	  artifacts.

	  The 0xSCADA module captures:
	  - Kernel execution traces (ftrace integration)
	  - Industrial protocol transactions (Modbus, DNP3, IEC 61850)
	  - Hardware I/O events
	  - Agent decision points

	  If unsure, say N.

if SCADA_0X

config SCADA_0X_CORE
	tristate "0xSCADA Core Artifact Infrastructure"
	default y
	help
	  Core infrastructure for artifact capture, hashing, and storage.
	  This is required for all other 0xSCADA components.

config SCADA_0X_TRACE
	tristate "0xSCADA Trace Hooks"
	depends on SCADA_0X_CORE
	depends on FTRACE
	default y
	help
	  SCADA-specific ftrace hooks for capturing industrial control
	  events. Integrates with the kernel tracing infrastructure to
	  produce reality artifacts.

config SCADA_0X_NET
	tristate "0xSCADA Network Protocol Filtering"
	depends on SCADA_0X_CORE
	depends on NETFILTER
	default y
	help
	  Network filtering for industrial protocols. Captures and
	  creates artifacts for:
	  - Modbus TCP/RTU transactions
	  - DNP3 communications
	  - IEC 61850 GOOSE/MMS messages
	  - OPC UA sessions

config SCADA_0X_EBPF
	tristate "0xSCADA eBPF Integration"
	depends on SCADA_0X_CORE
	depends on BPF_SYSCALL
	default y
	help
	  eBPF-based artifact capture for high-performance tracing.
	  Allows user-space definition of capture points with kernel
	  performance.

config SCADA_0X_CRYPTO
	tristate "0xSCADA Cryptographic Verification"
	depends on SCADA_0X_CORE
	depends on CRYPTO_SHA256
	default y
	help
	  Cryptographic hashing and verification for artifacts.
	  Implements content-addressed storage and chain validation.

config SCADA_0X_DEBUG
	bool "0xSCADA Debug Output"
	depends on SCADA_0X_CORE
	default n
	help
	  Enable verbose debug output for 0xSCADA subsystem.
	  This produces significant log volume and should only
	  be enabled for development.

endif # SCADA_0X
