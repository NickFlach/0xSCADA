[Unit]
Description=0xSCADA Trace Capture Daemon
Documentation=https://github.com/0xscada/0xscada
After=network.target
Wants=scada-trace-kmod.service

[Service]
Type=forking
PIDFile=/var/run/scada-traced.pid
ExecStart=/usr/local/sbin/scada-traced
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/scada-trace /var/run

# Capabilities
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
