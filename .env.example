# 0xSCADA Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/0xscada

# Simulator
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=10000

# API Gateway
ENABLE_API_KEYS=false
# Comma-separated key:name:scope+scope records. Missing scopes grant nothing.
# Anchor switching requires operator+anchor.admin.
API_KEYS=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Flux State Engine Integration (ADR-0015, Issue #260)
# Set FLUX_URL to enable. Leave blank to disable.
FLUX_URL=
FLUX_AUTH_TOKEN=
FLUX_PUBLISH_INTERVAL_MS=10000
FLUX_ENTITY_PREFIX=scada/
FLUX_STREAM=scada
FLUX_SOURCE=0xscada-dev

# Anchor Backend Switch (Issue #455 / #443)
# Which blockchain backend events are anchored to at startup.
# One of: l2 | node | both. Defaults to "node" (local PoA chain) if unset.
# Flip at runtime via POST /api/admin/anchor-backend (admin UI: /admin/anchor-backend).
ANCHOR_BACKEND=node
# Runtime switching is process-local and therefore held unless production
# declares exactly one server replica.
OXSCADA_REPLICA_COUNT=1
# Required to prepare and use the real L2 anchor pipeline.
ANCHOR_RPC_URL=http://localhost:8545
ANCHOR_CHAIN_ID=31337
EVENT_ANCHOR_CONTRACT=
ANCHOR_PRIVATE_KEY=
ANCHOR_HSM_KEY_PATH=
