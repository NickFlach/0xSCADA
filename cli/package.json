{
  "name": "0xscada-cli",
  "version": "1.0.0",
  "description": "CLI tool for 0xSCADA development and operations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "0xscada": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "scada",
    "blockchain",
    "industrial",
    "automation",
    "cli"
  ],
  "author": "0xSCADA Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^17.2.3",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "rimraf": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
